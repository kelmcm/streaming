# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- Feed API keys (only the poller needs these) ---
STM_API_KEY=

# --- Postgres (used by the postgres container AND the app) ---
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit
POSTGRES_HOST=localhost      # compose overrides this to "postgres" inside containers
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # compose overrides this to kafka:29092 inside containers
